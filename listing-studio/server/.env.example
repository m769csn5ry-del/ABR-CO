# Listing Studio — configuration serveur
# Copiez ce fichier en .env (jamais versionné) ou exportez ces variables.
#
# AUCUNE de ces valeurs ne doit être référencée depuis le frontend :
# le navigateur ne connaît que /api/*.

# Clé du fournisseur IA. Sans elle, l'application fonctionne en mode local.
ANTHROPIC_API_KEY=

# Modèle utilisé côté serveur (par défaut : claude-opus-5).
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=16000

# Réseau
PORT=4173
HOST=127.0.0.1

# Base de données (schéma dans server/schema.sql) — non requise pour la
# version navigateur, prévue pour le passage multi-utilisateurs.
DATABASE_URL=

# Stockage objet des photos (S3, R2…) — non requis en mode navigateur.
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
