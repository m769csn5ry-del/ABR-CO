# Copie ce fichier en .env.local et renseigne ce que tu raccordes.
# Tant qu'une variable est absente, la route correspondante répond 501
# avec un message explicite — rien n'est jamais simulé.

# Paiement (app/api/commande/route.ts)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Demandes d'atelier (app/api/entretien/route.ts)
CARE_INBOX=

# Formulaire de contact (app/api/contact/route.ts)
CONTACT_INBOX=

# Lettre d'information (app/api/newsletter/route.ts)
NEWSLETTER_API_KEY=
NEWSLETTER_LIST_ID=
